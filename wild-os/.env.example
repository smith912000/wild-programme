# Whop OAuth app (Whop dashboard). Client id only; the client secret stays in n8n.
# VITE_WHOP_CLIENT_ID=app_sBkrxfbNvViybN
# VITE_WHOP_SCOPE=openid profile email
# VITE_WHOP_AUTHORIZE_URL=https://api.whop.com/oauth/authorize

# n8n webhook base (default shown)
# VITE_N8N_AUTH_BASE=https://smith912000.app.n8n.cloud/webhook

# Checkout links (defaults shown in src/config/whop.js)
# VITE_WHOP_MONTHLY_URL=
# VITE_WHOP_ANNUAL_URL=

# Must match the redirect URL registered on the Whop app
# VITE_AUTH_REDIRECT_URI=https://smith912000.github.io/wild-os/auth/callback

# Dev only: member | expired
# VITE_WHOP_AUTH_MOCK=member
